# macOS system files
.DS_Store
._*

# Build artifacts and binaries
*.o
*.a
*.so
*.dylib
# Executables in the repository root only (anchored, so that directories
# called HydraMa2D elsewhere are never silently ignored)
/HydraMa2D
/HydraMa2D.exe
/HydraMa2D_cpp
build/
build-*/
bin/

# Python bytecode (tools/cylinder_benchmark, fixture generators)
__pycache__/
*.pyc

# Temporary and swap files
*.swp
*.swo
*~
fort.*
*.log

# Simulation outputs (preserve results directory with .gitkeep)
**/results/*.vtk
**/results/*.var
**/results/*.turb.var
**/results/*.monitors.dat
!**/results/.gitkeep
